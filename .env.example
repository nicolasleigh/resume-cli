# resume-cli 环境变量配置示例。
# 复制本文件为 .env 并填入真实值(.env 已被 .gitignore 忽略,不会提交到 GitHub)。
# 没有 API Key 时,可以使用 --mock 模式运行 extract / score 完成演示。

# OpenAI(或兼容 OpenAI 协议的服务)API Key。
OPENAI_API_KEY=

# 可选:自定义 API 网关地址(例如 OpenAI 兼容的中转服务)。
# deepseek模型
OPENAI_BASE_URL=https://api.deepseek.com

# 可选:使用的模型名称。留空时使用默认值 gpt-4o-mini。
OPENAI_MODEL=deepseek-v4-flash
